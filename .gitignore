# NOTE: git treats an inline "# comment" after a pattern as part of the pattern,
# so every comment here is on its own line.

# --- Secrets & personal data (NEVER commit) ---
.env
*.env
!.env.example
# Captured traffic: contains personal data + live session cookies.
*.har
# Raw captures (personal academic data / recon).
backend/captures/
docs/captures/
# Console (ucamcloud) capture/build tooling: kept LOCAL only. These are the
# maintainer's offline tools for refreshing the section catalog once per
# trimester. They are never used by the shipped app or backend, and — since the
# console enabled bot detection — we don't publish scripts that map/capture its
# API. The generated catalog (backend/data/section_catalog.json) IS committed;
# only the tooling that produces it stays off the public repo.
tools/console_capture.py
tools/build_catalog.py
tools/SECTION_CATALOG.md

# --- Internal docs (not part of the shipped app) ---
# Working notes, audits, and captures. Internal only.
docs/

# --- Python ---
backend/.venv/
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Databases ---
*.db
*.sqlite
*.sqlite3

# --- Flutter ---
app/.dart_tool/
app/build/
app/.flutter-plugins
app/.flutter-plugins-dependencies
app/.metadata
.pub-cache/
.pub/
# Generated platform ephemeral files (created by `flutter create --platforms=...`).
app/android/.gradle/
app/android/local.properties
# Android release signing: never commit the keystore or its passwords.
app/android/key.properties
app/android/**/*.jks
app/android/**/*.keystore
app/**/GeneratedPluginRegistrant.*
app/ios/Flutter/Generated.xcconfig
app/ios/Flutter/flutter_export_environment.sh

# --- Editors / OS ---
.vscode/
.idea/
*.iml
.DS_Store
.AppleDouble
Thumbs.db
ehthumbs.db
desktop.ini

# --- Misc build / temp artifacts ---
*.log
*.tmp
scratchpad/

# --- Claude Code local tooling ---
.claude/
